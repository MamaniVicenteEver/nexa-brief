# Backend API (nexa-brief-server)
NEXT_PUBLIC_API_URL=

# Auth.js — generar con: openssl rand -base64 32
AUTH_SECRET=
# AUTH_URL is derived from the root PUBLIC_APP_URL by make dev / Docker Compose.

# Compartidos con nexa-brief-server para proteger el proxy y firmar enlaces.
NEXA_INTERNAL_TOKEN=
NEXA_LINK_SECRET=

# La URL pública se configura una sola vez en el .env de la raíz: PUBLIC_APP_URL.

# Resend (envío de emails)
RESEND_API_KEY=
EMAIL_FROM="Nexa Brief <no-reply@tudominio.com>"

# A dónde llegan los emails de solicitud de acceso pendiente
ADMIN_EMAIL=

# Solo para `pnpm dev` abierto desde otra máquina (IP de LAN/Tailscale), separadas por coma.
# ALLOWED_DEV_ORIGINS=100.121.225.59
