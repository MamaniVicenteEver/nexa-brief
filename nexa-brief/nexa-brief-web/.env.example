# Backend API (nexa-brief-server)
NEXT_PUBLIC_API_URL=

# Auth.js — generar con: openssl rand -base64 32
AUTH_SECRET=
# AUTH_URL is derived from the root PUBLIC_APP_URL by make dev / Docker Compose.

# Atajo de desarrollo (solo funciona con NODE_ENV=development). Para habilitarlo
# en la máquina local, agregá DEV_LOGIN=true a este archivo ignorado.
DEV_LOGIN=false
# El dominio público exige además DEV_LOGIN_PUBLIC=true y una clave en el .env
# raíz del servidor; nunca copies esa clave a este archivo ni al repositorio.
DEV_LOGIN_PUBLIC=false
# Credenciales opcionales del atajo, solo se leen en el servidor; por defecto usa
# el admin de desarrollo existente (admin@nexabrief.com / admin123).
# DEV_LOGIN_EMAIL=
# DEV_LOGIN_PASSWORD=

# Compartidos con nexa-brief-server para proteger el proxy y firmar enlaces.
NEXA_INTERNAL_TOKEN=
NEXA_LINK_SECRET=

# La URL pública se configura una sola vez en el .env de la raíz: PUBLIC_APP_URL.

# Resend (envío de emails)
RESEND_API_KEY=
EMAIL_FROM="Nexa Brief <no-reply@tudominio.com>"

# A dónde llegan los emails de solicitud de acceso pendiente
ADMIN_EMAIL=

# Orígenes adicionales para `next dev`, separados por comas. El valor por defecto
# ya permite localhost y 192.168.20.*; usá esta variable para otras redes LAN/Tailscale.
# DEV_ALLOWED_ORIGINS=100.121.225.59,otra-maquina.local
