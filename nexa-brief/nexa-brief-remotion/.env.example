# Copiar este archivo a ".env" (sin el ".example") y completar con las
# credenciales reales de un usuario IAM de AWS creado específicamente para
# Remotion Lambda. Ver nexa-brief-docs/guia_migracion_remotion_lambda.md
# para el proceso completo paso a paso.
#
# NUNCA subir el archivo ".env" real a git (ya está en .gitignore raíz del
# repo, no lo saques de ahí).

REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
