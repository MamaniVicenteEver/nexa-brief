# Host ports used by Docker Compose.
WEB_PORT=3000
API_PORT=8000

# Canonical public origin for web links and OAuth callbacks (one value for the whole app).
# For a Cloudflare Quick Tunnel, set its current https:// hostname here.
PUBLIC_APP_URL=http://localhost:3000

# Atajo de login disponible únicamente con `make dev` y NODE_ENV=development.
# En la máquina del usuario se configura en nexa-brief-web/.env.local.
# DEV_LOGIN=true
# En el servidor, DEV_LOGIN_PUBLIC=true requiere DEV_LOGIN_PUBLIC_KEY en este
# .env ignorado; `make dev` lo pasa a la web. No se comparte por Git.
# DEV_LOGIN_PUBLIC=true
# DEV_LOGIN_PUBLIC_KEY=
# Credenciales opcionales del acceso directo; el valor predeterminado coincide
# con el admin de desarrollo del script seed-admin.
# DEV_LOGIN_EMAIL=prueba@nexa.local
# DEV_LOGIN_PASSWORD=admin

# Orígenes adicionales de next dev, separados por comas.
# El valor por defecto permite localhost y 192.168.20.*.
# DEV_ALLOWED_ORIGINS=

# Docker scheduled publishing is opt-in; set true only after reviewing the queue.
NEXA_ENABLE_AUTO_PUBLISHING=false

# Browser-facing API URL; normally leave empty so the browser uses the same origin.
NEXT_PUBLIC_API_URL=

# De dónde bajar los audios/videos de las plantillas (`make media-pull`):
# <host ssh>:<ruta a esta carpeta nexa-brief>. Pedí acceso al equipo.
# MEDIA_REMOTE=ever-server:Proyectos/nexa-brief/nexa-brief

# Servicio local de sesiones TikTok
TIKTOK_SERVICE_URL=http://127.0.0.1:8100
TIKTOK_SERVICE_KEY=
