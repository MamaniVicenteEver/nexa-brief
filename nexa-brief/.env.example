# Host ports used by Docker Compose.
WEB_PORT=3000
API_PORT=8000

# Canonical public origin for web links and OAuth callbacks (one value for the whole app).
# For a Cloudflare Quick Tunnel, set its current https:// hostname here.
PUBLIC_APP_URL=http://localhost:3000

# Browser-facing API URL; normally leave empty so the browser uses the same origin.
NEXT_PUBLIC_API_URL=

# De dónde bajar los audios/videos de las plantillas (`make media-pull`):
# <host ssh>:<ruta a esta carpeta nexa-brief>. Pedí acceso al equipo.
# MEDIA_REMOTE=ever-server:Proyectos/nexa-brief/nexa-brief
