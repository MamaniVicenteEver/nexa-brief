{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SoundCuratorOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "description",
    "recommended_uses",
    "tags"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "recommended_uses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      }
    }
  }
}
