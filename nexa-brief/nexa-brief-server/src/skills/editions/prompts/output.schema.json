        "caption": {
          "title": "Caption",
          "type": "string"
        },
        "hashtags": {
          "items": {
            "type": "string"
          },
          "title": "Hashtags",
          "type": "array"
        }
      },
      "required": [
        "caption",
        "hashtags"
