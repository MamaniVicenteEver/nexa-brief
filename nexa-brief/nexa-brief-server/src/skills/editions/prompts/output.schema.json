          "type": "string"
        },
        "strap": {
          "default": "",
          "title": "Strap",
          "type": "string"
        },
        "seal": {
          "default": "",
          "title": "Seal",
          "type": "string"
        },
        "tape_text": {
          "default": "",
          "title": "Tape Text",
          "type": "string"
        },
        "before_label": {
          "default": "",
          "title": "Before Label",
          "type": "string"
        },
        "after_label": {
          "default": "",
          "title": "After Label",
          "type": "string"
        }
      },
      "required": [
        "text"
