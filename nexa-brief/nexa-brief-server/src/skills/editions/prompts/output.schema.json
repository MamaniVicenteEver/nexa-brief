      "type": "string"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/Segment"
      },
      "title": "Segments",
      "type": "array"
    },
    "strings": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Strings",
      "type": "object"
    },
    "cues": {
      "additionalProperties": {
        "$ref": "#/$defs/Cue"
      },
      "title": "Cues",
      "type": "object"
    },
    "publish": {
      "$ref": "#/$defs/Publish"
    },
    "observations": {
      "items": {
        "type": "string"
      },
      "title": "Observations",
      "type": "array"
    },
    "packaging": {
      "anyOf": [
        {
          "$ref": "#/$defs/NativePackaging"
        },
        {
          "type": "null"
        }
      ],
      "default": null
