{
  "$defs": {
    "Chapter": {
      "additionalProperties": false,
      "properties": {
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "title"
      ],
      "title": "Chapter",
      "type": "object"
    },
    "Cue": {
      "additionalProperties": false,
      "properties": {
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "target_phrase": {
          "minLength": 1,
          "title": "Target Phrase",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "target_phrase"
      ],
      "title": "Cue",
      "type": "object"
    },
    "ImageText": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "pair_title": {
          "default": "B",
          "enum": [
            "A",
            "B",
            "C"
          ],
          "title": "Pair Title",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ImageText",
      "type": "object"
    },
    "NativePackaging": {
      "additionalProperties": false,
      "properties": {
        "titles": {
          "items": {
            "$ref": "#/$defs/NativeTitle"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Titles",
          "type": "array"
        },
        "chosen_title": {
          "default": "A",
          "enum": [
            "A",
            "B",
            "C"
          ],
          "title": "Chosen Title",
          "type": "string"
        },
        "text_only": {
          "$ref": "#/$defs/TextOnly"
        },
        "with_image": {
          "$ref": "#/$defs/ImageText"
        },
        "tabloid": {
          "$ref": "#/$defs/TabloidText"
        },
        "chosen_thumbnail": {
          "default": "tabloid",
          "enum": [
            "text_only",
            "with_image",
            "tabloid"
          ],
          "title": "Chosen Thumbnail",
          "type": "string"
        },
        "kicker": {
          "default": "",
          "title": "Kicker",
          "type": "string"
        }
      },
      "required": [
        "titles",
        "text_only",
        "with_image",
        "tabloid"
      ],
      "title": "NativePackaging",
      "type": "object"
    },
    "NativeTitle": {
      "additionalProperties": false,
      "properties": {
        "option": {
          "enum": [
            "A",
            "B",
            "C"
          ],
          "title": "Option",
          "type": "string"
        },
        "text": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "strategy": {
          "minimum": 1,
          "title": "Strategy",
          "type": "integer"
        },
        "emotion": {
          "minLength": 1,
          "title": "Emotion",
          "type": "string"
        }
      },
      "required": [
        "option",
        "text",
        "strategy",
        "emotion"
      ],
      "title": "NativeTitle",
      "type": "object"
    },
    "Publish": {
