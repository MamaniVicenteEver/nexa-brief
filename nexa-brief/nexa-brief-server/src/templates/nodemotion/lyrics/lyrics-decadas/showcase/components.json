  "components": [
    {
      "name": "decadas.intro",
      "label": "Intro letras gigantes",
      "summary": "Letras del título una a una con foto y firma; luego el título tecleado con etiquetas.",
      "tags": [
        "intro"
      ],
      "file": "components/intro.js",
      "params": {
        "title": {
          "type": "string",
          "default": "Dueles tan bien",
          "doc": "config.intro.title"
        },
        "artist": {
          "type": "string",
          "default": "Bruses",
          "doc": "config.intro.artist"
        },
        "duration": {
          "type": "number",
          "default": 3.4,
          "doc": "Segundos",
          "min": 1.5,
          "max": 10
        }
