{
  "version": 1,
  "family": "rough",
  "title": "Todavía se puede leer",
  "defaults": {
    "offset": -0.12
  },
  "beats": [
    {
      "t": 0,
      "use": "rough.introv2",
      "params": {
        "text": "TODAVÍA SE PUEDE LEER",
        "kicker": "CÓDIGOS QR",
        "textPortrait": "TODAVÍA SE PUEDE LEER",
        "src": "/nodetech/por-que-un-codigo-qr-puede-seguir-funcionando-au/assets/media/qr-danado.jpg"
      },
      "shows": "QR de papel con esquina inferior derecha arrancada",
      "query": "damaged QR code; QR code error correction",
      "media_review": "Aprobado: en las hojas horizontal y vertical se distingue el sujeto descrito en shows. El QR dañado tiene un desgarro visible; el esquema completo muestra módulos negros y blancos. No se presenta como experimento propio.",
      "until": "Cómo recupera algo"
    },
    {
      "at": "Cómo recupera algo",
      "use": "common.punch",
      "params": {
        "text": "NO ESTÁ\n^ADIVINANDO^",
        "size": 0.75
      },
      "until": "Un código"
    },
    {
      "at": "Un código",
      "use": "rough.photo",
      "params": {
        "caption": "Blanco y negro: información",
        "src": "assets/media/qr-estructura.jpg",
        "sub": "SÍMBOLO QR · ESQUEMA",
        "ar": 1,
        "focus": [
          0.5,
          0.5
        ]
      },
      "shows": "Diagrama de un QR completo, con módulos blancos y negros",
      "query": "QR code example; QR code structure",
      "media_review": "Aprobado: en las hojas horizontal y vertical se distingue el sujeto descrito en shows. El QR dañado tiene un desgarro visible; el esquema completo muestra módulos negros y blancos. No se presenta como experimento propio.",
      "until": "calculada para reparar"
    },
    {
      "at": "calculada para reparar",
      "use": "rough.note",
      "params": {
        "title": "DATOS + REDUNDANCIA",
        "note": "Se añade al crear el QR",
        "caption": "REDUNDANCIA · CORRECCIÓN DE ERRORES"
      },
      "until": "antes de que aparezca"
    },
    {
      "at": "antes de que aparezca",
      "use": "rough.notemark",
      "params": {
        "title": "ANTES DEL DAÑO",
        "marks": [
          "información extra",
          "ocupa espacio"
        ],
        "note": "La protección tiene un costo"
      },
      "until": "Imagina una nota"
    },
    {
      "at": "Imagina una nota",
      "use": "common.punch",
      "params": {
        "text": "3     5",
        "size": 0.85
      },
      "until": "Debajo anotas"
    },
    {
      "at": "Debajo anotas",
      "use": "common.punch",
      "params": {
        "text": "3 + 5 = ^8^",
        "size": 0.85
      },
      "until": "Esa suma parece"
    },
    {
      "at": "Esa suma parece",
      "use": "rough.notemark",
      "params": {
        "title": "3 + 5 = 8",
        "marks": [
          "datos: 3 y 5",
          "pista: suma 8"
        ],
        "note": "Mientras todo es legible…"
      },
      "until": "Ahora el 5"
    },
    {
      "at": "Ahora el 5",
      "use": "common.punch",
      "params": {
        "text": "3 + ^?^ = 8",
        "size": 0.85
      },
      "until": "Restas 3 a 8"
    },
    {
      "at": "Restas 3 a 8",
      "use": "common.punch",
      "params": {
        "text": "8 − 3 = ^5^",
        "size": 0.85
      },
      "until": "La información extra"
    },
    {
      "at": "La información extra",
      "use": "common.punch",
      "params": {
        "text": "LA PISTA\n^SOBREVIVIÓ^",
        "size": 0.75
      },
      "until": "Es una analogía"
    },
    {
      "at": "Es una analogía",
      "use": "rough.introv2",
      "params": {
        "text": "EL SISTEMA\nREAL",
        "src": "assets/media/qr-danado.jpg",
        "highlight": "REAL",
        "kicker": "REED–SOLOMON",
        "focus": "xMidYMid",
        "sub": "La suma es solo una analogía"
      },
      "shows": "QR parcialmente arrancado; ejemplo de daño, no prueba del nivel H",
      "query": "damaged QR code; QR code error correction",
      "media_review": "Aprobado: en las hojas horizontal y vertical se distingue el sujeto descrito en shows. El QR dañado tiene un desgarro visible; el esquema completo muestra módulos negros y blancos. No se presenta como experimento propio.",
      "until": "Usa relaciones matemáticas"
    },
    {
      "at": "Usa relaciones matemáticas",
      "use": "rough.notemark",
      "params": {
        "title": "REED–SOLOMON",
        "marks": [
          "localizar errores",
          "corregir errores",
          "dentro de límites"
        ],
        "note": "Redundancia matemática"
      },
      "until": "Existen cuatro niveles"
    },
    {
      "at": "Existen cuatro niveles",
      "use": "rough.counter",
      "params": {
        "from": 4,
        "to": 4,
        "dur": 0.5,
        "label": "PROTECCIÓN",
        "unit": "niveles"
      },
      "until": "El más alto permite"
    },
    {
      "at": "El más alto permite",
      "use": "rough.counter",
      "params": {
        "from": 30,
        "to": 30,
        "suffix": " %",
        "dur": 0.5,
        "label": "NIVEL H · APROXIMADAMENTE",
        "unit": "de unidades codificadas"
      },
      "until": "No de cualquier pedazo"
    },
    {
      "at": "No de cualquier pedazo",
      "use": "common.punch",
      "params": {
        "text": "NO DE\nCUALQUIER\n^PEDAZO^",
        "size": 0.75
      },
      "until": "El lector necesita"
    },
    {
      "at": "El lector necesita",
      "use": "rough.introv2",
      "params": {
        "text": "ESQUINAS\nY MARGEN",
        "src": "assets/media/qr-estructura.jpg",
        "highlight": "Y MARGEN",
        "kicker": "CÓDIGOS QR",
        "focus": "xMidYMid"
      },
      "shows": "QR con tres grandes localizadores y margen blanco exterior",
      "query": "QR code example; QR code structure",
      "media_review": "Aprobado: ambas hojas muestran el QR completo, tres localizadores y margen blanco; apoya la frase sobre reconocer el símbolo.",
      "until": "puede fallar antes"
    },
    {
      "at": "puede fallar antes",
      "use": "rough.notemark",
      "params": {
        "title": "PRIMERO: RECONOCER",
        "marks": [
          "después: reparar"
        ],
        "note": "Si no reconoce, puede fallar"
      },
      "until": "Por eso una etiqueta"
    },
    {
      "at": "Por eso una etiqueta",
      "use": "rough.note",
      "params": {
        "title": "RESISTIR EL DAÑO",
        "note": "La protección ya estaba dentro",
        "caption": "REDUNDANCIA · CORRECCIÓN DE ERRORES"
      },
      "until": "No sobrevivió por magia"
    },
    {
      "at": "No sobrevivió por magia",
      "use": "common.punch",
      "params": {
        "text": "INFORMACIÓN\nPARA ^RESISTIR^",
        "size": 0.75
      },
      "until": "Qué otra tecnología"
    },
    {
      "at": "Qué otra tecnología",
      "layer": "main",
      "use": "common.question",
      "params": {
        "text": "¿Qué tecnología cotidiana\nte gustaría mirar por dentro?"
      },
      "dur": 4.56
    }
  ]
}
