          "fog-road",
          "empty-room"
        ]
      },
      "mirror": {
        "weight": 1.3,
        "media": [
          "fog-road",
          "fog-walk",
          "ocean-figure"
        ]
      },
      "breath": {
        "weight": 1.0
      },
      "fragments": {
        "weight": 1.0,
        "media": [
          "snow-night",
          "empty-room"
        ]
      },
      "tear": {
        "weight": 1.1,
        "media": [
          "empty-room",
          "fog-road",
          "window-silhouette",
          "ocean-figure"
