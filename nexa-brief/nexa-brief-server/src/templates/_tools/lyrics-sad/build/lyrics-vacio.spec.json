{
  "title": "Vacío — Lyric Video",
  "out": "nodemotion/lyrics/lyrics-vacio",
  "js": [
    "sad-common.js",
    "vacio.js"
  ],
  "about": "soledad y vacío: blanco y negro frío con niebla, condensada finísima o pesada, letras que se separan y se desmoronan, ecos, reflejos, pantalla rasgada y una palabra que respira en negro.",
  "fontLoads": [
    "100 100px 'Big Shoulders Display'",
    "800 100px 'Big Shoulders Display'",
    "300 100px Inter"
  ],
  "css": "  .th { font-family: \"Big Shoulders Display\", sans-serif; font-weight: 100; text-transform: uppercase; }\n  .hv { font-family: \"Big Shoulders Display\", sans-serif; font-weight: 800; text-transform: uppercase; }\n  .in { font-family: \"Inter\", sans-serif; font-weight: 300; text-transform: uppercase; }\n",
  "config": {
    "id": "default",
    "description": "Lyric video de soledad y vacío: blanco y negro frío con niebla, rutas perdidas, cuartos vacíos y una figura frente al mar; tipografía condensada finísima o muy pesada, letras que se separan hasta perderse, palabras que se desmoronan, estelas de eco, reflejos en la bruma, la imagen que se rasga y una sola palabra que respira en el negro. — metadata para marketing/SEO, la plantilla no la usa todavía.",
    "audio": {
      "src": "assets/song.mp3"
    },
    "lyricsUrl": "assets/lyrics.json",
    "lyricsFilter": {
      "minLogprob": -0.6,
      "drop": [
        "gracias por ver",
        "subt[ií]tulos",
        "amara\\.org",
        "audio ?jungle",
        "suscr[ií]bete"
      ]
    },
    "fonts": {
      "googleUrl": "https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@100;800&family=Inter:wght@300&display=swap"
    },
    "palette": {
      "black": "#08090A",
      "white": "#ECEDEE",
      "fog": "#8F969A"
    },
    "grades": {
      "mist": {
        "type": "css",
        "saturate": 0.12,
        "contrast": 0.95,
        "brightness": 0.8
      },
      "bw": {
        "type": "duo",
        "dark": "#050607",
        "light": "#D6DADD",
        "contrast": 1.25
      }
    },
    "render": {
      "kbVideo": true
    },
    "media": [
      {
        "id": "fog-road",
        "type": "video",
        "src": "assets/media/fog-road.mp4",
        "poster": "assets/media/fog-road-1.jpg"
      },
      {
        "id": "fog-walk",
        "type": "video",
        "src": "assets/media/fog-walk.mp4",
        "poster": "assets/media/fog-walk-1.jpg"
      },
      {
        "id": "empty-room",
        "type": "video",
        "src": "assets/media/empty-room.mp4",
        "poster": "assets/media/empty-room-1.jpg"
      },
      {
        "id": "ocean-figure",
        "type": "video",
        "src": "assets/media/ocean-figure.mp4",
        "poster": "assets/media/ocean-figure-1.jpg"
      },
      {
        "id": "snow-night",
        "type": "video",
        "src": "assets/media/snow-night.mp4",
        "poster": "assets/media/snow-night-1.jpg"
      },
      {
        "id": "window-silhouette",
        "type": "video",
        "src": "assets/media/window-silhouette.mp4",
        "poster": "assets/media/window-silhouette-1.jpg"
      }
    ],
    "phrases": {
      "maxWords": 8,
      "maxSec": 5.5,
      "minWords": 3
    },
    "timing": {
      "leadSec": 0.15,
      "holdSec": 1.1,
      "gapSec": 2.6,
      "echoSec": 1.6,
      "echoPhraseSec": 3.0,
      "cooldown": 3
    },
    "transition": {
      "overlapSec": 0.7,
      "weights": {
        "fade": 2,
        "iris": 1.2,
        "slice": 1.2,
        "zoomOut": 1.2,
        "bars": 1,
        "blur": 1
      }
    },
    "layouts": {
      "lonely": {
        "weight": 1.8,
        "media": [
