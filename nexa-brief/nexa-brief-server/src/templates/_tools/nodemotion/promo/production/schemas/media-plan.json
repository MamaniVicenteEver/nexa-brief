{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa-brief.local/schemas/nodemotion-promo/media-plan.json",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scene": {
            "type": "integer",
            "minimum": 1
          },
          "slot": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "image",
              "video"
            ]
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "manual_selection": {
            "type": "boolean",
            "description": "Marca interna del host para una selección explícita de una persona."
          },
          "orientation": {
            "enum": [
              "landscape",
              "portrait",
              "square"
            ]
          },
          "minimum_duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "provider_id": {
            "type": "string",
            "minLength": 1
          },
          "required_terms": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "pattern": ".*\\S.*"
            }
          }
        },
        "required": [
          "scene",
          "slot",
          "kind",
          "query"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
