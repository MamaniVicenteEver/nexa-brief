{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa-brief.local/schemas/nodemotion-promo/usage-entry.json",
  "type": "object",
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "step": {
      "type": "string",
      "minLength": 1
    },
    "iteration": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cached_input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "reasoning_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "ok": {
      "type": "boolean"
    },
    "billing": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string"
    },
    "cost": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "reported_total_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Total informado sin desglose; no sumarlo otra vez al desglose de la misma llamada."
    }
  },
  "required": [
    "ts",
    "provider",
    "model",
    "role",
    "step",
    "input_tokens",
    "cached_input_tokens",
    "output_tokens",
    "seconds",
    "ok",
    "billing"
  ],
  "additionalProperties": false
}
