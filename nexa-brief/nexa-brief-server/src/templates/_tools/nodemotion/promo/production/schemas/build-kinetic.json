{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa-brief.local/schemas/nodemotion-promo/build-kinetic.json",
  "type": "object",
  "properties": {
    "template": {
      "const": "promo-kinetic"
    },
    "texts": {
      "type": "object",
      "properties": {
        "brand.tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        }
      },
      "required": [
        "brand.tag"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "template",
    "texts"
  ]
}
