{
  "id": "collage",
  "family": "collage",
  "name": "HEMEROTECA",
  "tagline": "Historia contada con recortes de archivo: fotos, diarios y años sobre una mesa infinita",
  "topics": [
    "historia",
    "aniversarios",
    "conmemoraciones",
    "países",
    "instituciones",
    "biografías",
    "acontecimientos del siglo XX"
  ],
  "channel": {
    "name": "HEMEROTECA",
    "handle": "@hemeroteca",
    "language": "es-419",
    "note": "nombre provisional: cambiar aquí y se actualiza en todos los videos"
  },
  "fontsCss": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,500;1,600&family=Cinzel:wght@500;700&family=Playfair+Display:wght@700;800;900&family=Old+Standard+TT:ital,wght@0,400;0,700;1,400&family=Open+Sans:wght@400;600&display=swap",
  "scripts": [
    "designs/common/text.js",
    "designs/collage/components/_collage.js",
    "designs/collage/components/intro.js",
    "designs/collage/components/scenes.js",
    "designs/collage/components/special.js",
    "designs/common/hook.js",
    "designs/common/clip.js",
    "designs/collage/components/intros.js",
    "designs/common/outro-v1.js",
    "designs/collage/components/outro.js"
  ],
  "defaults": {
    "family": "collage",
    "palette": {
      "bg": "#14191c",
      "bg2": "#e6d6cc",
      "ink": "#2a2226",
      "muted": "#6a5a5e",
      "accent": "#9e2f4f",
      "accent2": "#b13a5c",
      "accentInk": "#fff3ef",
      "year": "#7c2b37",
      "headline": "#5e1a22",
      "band": "rgba(46,34,50,0.88)",
      "bandInk": "#f6e8e2",
      "gold": "#d1a95a",
      "url": "#9a4a26"
    },
    "fonts": {
      "main": "Cormorant Garamond",
      "load": [
        "600 40px 'Cormorant Garamond'",
        "italic 500 40px 'Cormorant Garamond'",
        "700 40px Cinzel",
        "800 40px 'Playfair Display'",
        "400 20px 'Old Standard TT'",
        "400 20px 'Open Sans'"
      ]
    },
    "captions": {
      "enabled": true,
      "maxWords": 5,
      "gap": 0.6,
      "hold": 0.35
    },
    "collage": {
      "grain": 0.2
    },
    "transition": {
      "overlap": 1.0
    },
    "outro": {
      "enabled": true,
      "dur": 6.2,
      "thanks": "GRACIAS POR VER",
      "channel": "NODEHISTORY",
      "cta": "SUSCRÍBETE",
      "support": "apoya el canal · comparte la historia",
      "handle": "youtube.com/@nodehistory",
      "use": "collage.outro"
    },
    "clip": {
      "filter": "grayscale(1) contrast(1.25)",
      "frame": "palette.ink",
      "dim": 0.18
    }
  },
  "voice": {
    "voice": "Charon",
    "alternatives": [
      "Sadaltager",
      "Algenib",
      "Orus"
    ],
    "models": [
      "gemini-3.8-flash-tts",
      "gemini-3.8-flash-lite-tts",
      "gemini-3.1-flash-tts-preview"
    ],
    "lead": 1.2,
    "tail": 6.0,
    "base": "Narrador de documental histórico conmemorativo, voz masculina madura, cálida y solemne, español latinoamericano neutro (sin ceceo). Sobrio, con orgullo contenido, sin dramatizar de más. No imitar a ninguna persona real. Ritmo pausado y natural, alrededor de 125 palabras por minuto: deja respirar el final de cada oración.",
    "target_wpm": [
      115,
      130
    ]
  },
  "media": {
    "photos": "fotos de archivo (personas, lugares, documentos, multitudes); se viran a B/N, verde azulado, rosa o sepia con trama de semitono y se reutilizan con distinto encuadre/zoom en muchos collages",
    "portrait_tip": "collage.portraits y collage.tribute recortan en óvalo centrado arriba: elegir retratos con la cara en el tercio superior",
    "per_video": [
      5,
      12
    ]
  }
}
