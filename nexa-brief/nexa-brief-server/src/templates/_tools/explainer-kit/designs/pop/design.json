{
  "id": "pop",
  "family": "pop",
  "name": "DUOTONO",
  "tagline": "Historias y cultura en clave de póster editorial: menta, violeta y fotos en duotono",
  "topics": [
    "cultura",
    "historia reciente",
    "diseño",
    "música",
    "moda",
    "deporte",
    "ciudades",
    "tendencias"
  ],
  "channel": {
    "name": "DUOTONO",
    "handle": "@duotono",
    "language": "es-419",
    "note": "nombre provisional: cambiar aquí y se actualiza en todos los videos"
  },
  "fontsCss": "https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Noto+Sans+JP:wght@700;900&family=Montserrat:wght@500;600;700&display=swap",
  "scripts": [
    "designs/common/text.js",
    "designs/pop/components/_pop.js",
    "designs/pop/components/intro.js",
    "designs/pop/components/type.js",
    "designs/pop/components/title.js",
    "designs/pop/components/photo.js",
    "designs/pop/components/graphic.js",
    "designs/common/outro-v1.js",
    "designs/common/hook.js",
    "designs/common/logo.js",
    "designs/common/clip.js",
    "designs/pop/components/intros.js",
    "designs/pop/components/outro.js",
    "designs/common/tabloid.js",
    "designs/common/question.js"
  ],
  "defaults": {
    "family": "pop",
    "palette": {
      "bg": "#3ccaaa",
      "ink": "#2a0e70",
      "mid": "#8a4075",
      "accent": "#cd697c",
      "light": "#3ccaaa",
      "muted": "#80898a",
      "paper": "#e8e8e8",
      "black": "#1d1d1d",
      "book": "#54baa0",
      "red": "#e2463c"
    },
    "fonts": {
      "main": "Archivo",
      "load": [
        "800 expanded 40px Archivo",
        "900 expanded 40px Archivo",
        "700 expanded 20px Archivo",
        "600 20px Montserrat",
        "900 40px 'Noto Sans JP'"
      ]
    },
    "captions": {
      "enabled": true,
      "maxWords": 4,
      "gap": 0.5,
      "hold": 0.3
    },
    "pop": {
      "grain": 0.04,
      "duo": [
        [
          0,
          "#2b0f70"
        ],
        [
          0.35,
          "#8a4075"
        ],
        [
          0.6,
          "#cd697c"
        ],
        [
          1,
          "#3ccaaa"
        ]
      ]
    },
    "transition": {
      "overlap": 0
    },
    "outro": {
      "enabled": true,
      "dur": 6,
      "thanks": "gracias por ver",
      "channel": "NODEHISTORY",
      "cta": "SUSCRÍBETE",
      "support": "apoya el canal · comparte el video",
      "handle": "youtube.com/@nodehistory",
      "use": "pop.outro"
    },
    "clip": {
      "filter": "grayscale(1) contrast(1.2)",
      "frame": "palette.ink",
      "dim": 0.18
    }
  },
  "voice": {
    "voice": "Charon",
    "alternatives": [
      "Sadaltager",
      "Algenib",
      "Orus"
    ],
    "models": [
      "gemini-3.8-flash-tts",
      "gemini-3.8-flash-lite-tts",
      "gemini-3.1-flash-tts-preview"
    ],
    "lead": 1.2,
    "tail": 6.0,
    "base": "Narrador de documental histórico, voz masculina madura, grave y cercana, español latinoamericano neutro (sin ceceo). Sobrio, sin dramatizar de más. No imitar a ninguna persona real. Ritmo pausado y natural, alrededor de 125 palabras por minuto: deja respirar el final de cada oración.",
    "target_wpm": [
      115,
      130
    ]
  },
  "media": {
    "photos": "fotos reales (personas, lugares, objetos, documentos); se muestran en DUOTONO menta/violeta/rosa (mapa de gradiente de la paleta) dentro de círculos, columnas, triángulos, letras y cajas",
    "portrait_tip": "las fotos se recortan 'cover' en formas muy distintas: usar focus=[x,y] para apuntar al sujeto; las 5–7 fotos se repiten con otro encuadre/zoom",
    "per_video": [
      5,
      9
    ]
  }
}
