{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "imperio.footage",
  "description": "Material de archivo en VIDEO (en vez de foto): el atlas se desatura a gris, baja humo oscuro y el clip mudo se funde en blanco y negro, en multiplicar, con el mapa; el sol y los rayos carmesí siguen encima. Como imperio.archive pero con movimiento real.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "video": {
      "type": "string",
      "description": "Clip mudo de assets/media (se pasa a B/N contrastado). Vacío = solo atlas gris, humo y rayos.",
      "default": ""
    },
    "start": {
      "type": "number",
      "minimum": 0,
      "description": "Segundo inicial del clip.",
      "default": 0
    },
    "rate": {
      "type": "number",
      "minimum": 0.2,
      "maximum": 2,
      "description": "Velocidad del clip (bajar si es corto).",
      "default": 1
    },
    "loop": {
      "type": "boolean",
      "description": "Repetir el clip si es más corto que el plano.",
      "default": true
    },
    "focus": {
      "type": "array",
      "description": "Punto de interés del clip [x,y] 0..1.",
      "default": [
        0.5,
        0.45
      ]
    },
    "country": {
      "type": "string",
      "description": "País foco: pone el sol y el rayado.",
      "default": "Japan"
    },
    "hatch": {
      "anyOf": [
        {
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "description": "Países ya ocupados (rayado fijo). Va acumulando de plano en plano.",
      "default": null
    },
    "sunAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/coordinate"
        },
        {
          "type": "null"
        }
      ],
      "description": "[lon, lat] del sol (vacío = centro del país foco).",
      "default": null
    },
    "sunSize": {
      "type": "number",
      "minimum": 0.2,
      "maximum": 6,
      "description": "Radio del sol en grados de mapa.",
      "default": 3
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "type": "string"
          },
          "at": {
            "$ref": "#/$defs/place"
          }
        },
        "required": [
          "t",
          "at"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "description": "Rótulos de mares: [{\"t\":\"Mar de\\nChina\", \"at\":[120,20]}].",
      "default": []
    },
    "compass": {
      "type": "boolean",
      "description": "Rosa de los vientos fina abajo a la derecha.",
      "default": true
    },
    "gray": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Desaturación del atlas.",
      "default": 0
    },
    "enter": {
      "type": "number",
      "minimum": 0,
      "maximum": 2,
      "description": "Segundos de fundido de entrada sobre el plano anterior.",
      "default": 0.7
    },
    "from": {
      "$ref": "#/$defs/camera",
      "description": "Cámara inicial [lon, lat, span°, giro°] o \"País*k\". Vacío = donde terminó el plano con mapa anterior.",
      "default": null
    },
    "to": {
      "$ref": "#/$defs/camera",
      "description": "Cámara final [lon, lat, span°, giro°] o \"País*k\". Vacío = encuadra el sol y todos los destinos.",
      "default": null
    },
    "zoom": {
      "type": "number",
      "minimum": 0.3,
      "maximum": 6,
      "description": "Si no hay `to`: cuánto se aleja la cámara.",
      "default": 1.3
    },
    "tilt": {
      "type": "number",
      "minimum": -20,
      "maximum": 20,
      "description": "Si no hay `to`: grados que gira el mapa.",
      "default": 3
    },
    "ease": {
      "enum": [
        "auto",
        "out",
        "in",
        "inOut",
        "linear",
        "expo"
      ],
      "description": "Curva de la cámara. expo = llega rápido y se asienta (los destinos entran ya encuadrados).",
      "default": "auto"
    },
    "rays": {
      "type": "number",
      "minimum": 0,
      "maximum": 60,
      "description": "Rayos del sol.",
      "default": 28
    },
    "dir": {
      "type": "number",
      "description": "Rumbo del abanico (0 = norte, 180 = sur).",
      "default": 180
    },
    "spread": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Cierre del abanico.",
      "default": 0.72
    },
    "rayFloor": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.4,
      "description": "Largo residual de los rayos opuestos.",
      "default": 0.02
    },
    "rayAlpha": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Opacidad de los rayos.",
      "default": 0.56
    },
    "rayLen": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 1,
      "description": "Largo de los rayos (fracción del lado largo).",
      "default": 0.46
    },
    "raysAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^@.+"
        }
      ],
      "description": "Segundo en que nacen los rayos.",
      "default": 0
    },
    "rayColor": {
      "type": "string",
      "description": "Color hex de los rayos en multiplicar (el demo usa un carmesí vivo). Vacío = granate grisáceo del mapa.",
      "default": ""
    },
    "ships": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "Barquitos sobre los rayos.",
      "default": 2
    },
    "grayDur": {
      "type": "number",
      "minimum": 0,
      "description": "Segundos en que el atlas pasa a gris.",
      "default": 0.9
    },
    "videoAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^@.+"
        }
      ],
      "description": "Segundo en que empieza a aparecer el clip.",
      "default": 0
    },
    "videoDur": {
      "type": "number",
      "minimum": 0.1,
      "description": "Duración del fundido del clip.",
      "default": 1
    },
    "strength": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Intensidad del clip (multiplicar).",
      "default": 0.95
    },
    "smoke": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Humo oscuro desde arriba.",
      "default": 0.7
    },
    "caption": {
      "type": "string",
      "description": "Rótulo chico en itálica abajo a la izquierda (lugar · año del metraje).",
      "default": ""
    }
  },
  "required": [],
  "$defs": {
    "coordinate": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "items": false
    },
    "place": {
      "anyOf": [
        {
          "$ref": "#/$defs/coordinate"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "camera": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number"
            }
          ],
          "minItems": 3,
          "maxItems": 4,
          "items": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "examples": [
    {
      "video": "samples/imperio-archive.mp4",
      "country": "Japan",
      "from": [
        145,
        35,
        125,
        3
      ],
      "to": [
        135,
        32,
        165,
        6
      ],
      "rays": 28,
      "dir": 180,
      "spread": 0.72,
      "rayFloor": 0.02,
      "rayAlpha": 0.56,
      "rayLen": 0.46,
      "compass": true,
      "caption": "ARCHIVO"
    }
  ],
  "x-layer": "main",
  "x-units": {
    "coordinates": "WGS84 [longitud, latitud], grados",
    "timing": "segundos relativos al beat o @ancla exacta de la narración",
    "screenPosition": "x/y normalizados 0..1 solo en texto de pantalla"
  }
}
