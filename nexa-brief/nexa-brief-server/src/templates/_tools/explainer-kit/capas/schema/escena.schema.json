  "title": "Parámetros common.capas v1",
  "$defs": {
    "actor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "asset": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "pose": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "escala": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 5
        },
        "profundidad": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "espejo": {
          "type": "boolean"
        },
        "estilo": {
          "$ref": "#/$defs/estilo"
        },
        "entrada": {
          "type": "object",
          "properties": {
            "anim": {
              "enum": [
                "entrar-sube",
                "entrar-cae",
                "entrar-desliza"
              ]
            },
            "dur": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3600
            }
          },
          "required": [
            "anim",
            "dur"
          ],
          "additionalProperties": false
        },
        "anim": {
          "enum": [
            "entrar-sube",
            "entrar-cae",
            "entrar-desliza",
            "salir-cae",
            "salir-funde",
            "respirar",
            "flotar",
            "temblar",
            "girar",
            "caer",
            "latir"
          ]
        }
      },
      "required": [
        "id",
        "asset"
      ],
      "additionalProperties": false
    },
    "estilo": {
      "type": "object",
      "properties": {
        "silueta": {
          "type": "boolean"
        },
        "brillo": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "sombra": {
          "type": "boolean"
        },
        "halo": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "zonas": {
          "type": "object",
          "patternProperties": {
            "^[a-z0-9]+(-[a-z0-9]+)*$": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
