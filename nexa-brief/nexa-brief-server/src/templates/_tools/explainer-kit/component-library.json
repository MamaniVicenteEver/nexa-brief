        "header": {
          "type": "string",
          "default": "pedido.js",
          "doc": "Nombre del archivo en la barra del editor (mono).",
          "required": false,
          "options": null,
          "min": null,
          "max": null
        },
        "lines": {
          "type": "array",
          "default": [
            "function cobrar(pedido) {",
            "  const total = sumar(pedido)",
            "  if (total < 0) borrar()",
            "  return enviar(total)",
            "}"
          ],
          "doc": "Líneas de código (hasta 6, ~26 caracteres).",
          "required": false,
          "options": null,
          "min": null,
          "max": null
        },
        "who": {
          "type": "string",
