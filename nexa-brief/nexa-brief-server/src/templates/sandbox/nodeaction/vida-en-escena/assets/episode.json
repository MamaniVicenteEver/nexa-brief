  },
  "script": [
    {
      "id": "N01",
      "who": "narrador",
      "emotion": "cálido, con humor contenido",
      "text": "Tomás siempre llega a la escuela con un minuto de sobra. Hoy, no."
    },
    {
      "id": "L01",
      "who": "nico",
      "emotion": "alegre, burlón",
      "text": "¡Tomás! Llegas tarde... y despeinado."
    },
    {
      "id": "L02",
      "who": "tomas",
      "emotion": "agitado, avergonzado, sin aire",
      "text": "Me quedé dormido. ¿Ya empezó la clase?"
    },
    {
      "id": "L03",
      "who": "nico",
      "emotion": "tranquilo, travieso",
      "text": "Todavía no. Pero hoy es el examen de historia."
    },
    {
      "id": "L04",
      "who": "tomas",
      "emotion": "pánico repentino",
      "text": "¿Hoy? ¡Pensé que era el viernes!"
    },
    {
      "id": "L05",
      "who": "nico",
      "emotion": "riendo, solidario",
      "text": "Tranquilo. Toma mis apuntes. Tienes diez minutos."
    },
    {
      "id": "L06",
      "who": "tomas",
      "emotion": "aliviado, agradecido",
      "text": "Eres el mejor."
    },
    {
      "id": "N02",
      "who": "narrador",
      "emotion": "irónico, ligero",
      "text": "Diez minutos después, Tomás sabía más de historia que en todo el año."
    },
    {
      "id": "L07",
      "who": "nico",
      "emotion": "susurrando, curioso",
      "text": "¿Y? ¿Cómo te fue?"
    },
    {
      "id": "L08",
      "who": "tomas",
      "emotion": "sorprendido de sí mismo, contento",
      "text": "Creo que bien. ¡Te debo una!"
    },
    {
      "id": "L09",
      "who": "nico",
      "emotion": "pícaro",
      "text": "Me debes un helado. De chocolate."
    },
    {
      "id": "N03",
      "who": "narrador",
      "emotion": "suave, con intriga leve",
      "text": "Por la tarde, Tomás fue al parque. Alguien lo estaba esperando."
    },
    {
      "id": "L10",
      "who": "valeria",
      "emotion": "cariñosa, alegre",
      "text": "¡Aquí estás! ¿Sobreviviste al examen?"
    },
    {
      "id": "L11",
      "who": "tomas",
      "emotion": "orgulloso",
      "text": "Gracias a Nico. Ahora le debo un helado."
    },
    {
      "id": "L12",
      "who": "valeria",
      "emotion": "juguetona",
      "text": "Entonces este es para ti."
    },
    {
      "id": "L13",
      "who": "tomas",
      "emotion": "tímido, sonrojado",
      "text": "¿Para mí? ¿Y eso por qué?"
    },
    {
      "id": "L14",
      "who": "valeria",
      "emotion": "dulce, ilusionada",
      "text": "Porque hoy cumplimos seis meses."
    },
    {
      "id": "L15",
      "who": "tomas",
      "emotion": "pánico contenido que se vuelve entusiasmo fingido",
      "text": "¿Seis... meses? ¡Claro! ¡Seis meses! Lo sabía."
    },
    {
      "id": "L16",
      "who": "valeria",
      "emotion": "escéptica y divertida",
      "text": "Lo olvidaste."
    },
    {
      "id": "L17",
      "who": "tomas",
      "emotion": "rendido, sonriendo",
      "text": "Un poquito. Pero el sábado te invito a cenar."
    },
    {
      "id": "L18",
      "who": "valeria",
      "emotion": "riendo",
      "text": "Trato hecho."
    },
    {
      "id": "L19",
      "who": "mama",
      "emotion": "cálida",
      "text": "Llegas justo a tiempo. La cena está servida."
    },
    {
      "id": "L20",
      "who": "tomas",
      "emotion": "cansado y feliz",
      "text": "Huele delicioso, mamá."
    },
    {
      "id": "L21",
      "who": "mama",
      "emotion": "curiosa",
      "text": "¿Y qué tal tu día?"
    },
    {
      "id": "L22",
      "who": "tomas",
      "emotion": "enumerando, divertido",
      "text": "Examen sorpresa, Nico me salvó... y casi olvido un aniversario."
    },
    {
      "id": "L23",
      "who": "mama",
      "emotion": "riendo, ceja alzada",
      "text": "¿Casi?"
    },
    {
      "id": "L24",
      "who": "tomas",
      "emotion": "encogiéndose de hombros, sonriendo",
      "text": "Bueno... lo olvidé. Pero ya lo arreglé."
    },
    {
      "id": "N04",
      "who": "narrador",
      "emotion": "cierre cálido",
      "text": "Un día cualquiera: un examen, un amigo, un helado... y una cena caliente al final."
    }
  ],
