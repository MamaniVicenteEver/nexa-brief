# NEXA BRIEF — researcher_data
# Copia este archivo como .env en esta misma carpeta y completa las credenciales
# una por una. Este archivo no se conecta al pipeline hasta que se integre de
# forma explícita en la aplicación.

# Cliente HTTP y optimización
RESEARCHER_USER_AGENT=NexaBriefResearcher/0.1 (contact: tu-correo@example.com)
RESEARCHER_REQUEST_TIMEOUT_SECONDS=30
RESEARCHER_REQUEST_MAX_RETRIES=2
RESEARCHER_REQUEST_RETRY_BACKOFF_SECONDS=0.6
RESEARCHER_MAX_PARALLEL_REQUESTS=6
RESEARCHER_CACHE_TTL_SECONDS=900

# Wikipedia / MediaWiki — no requiere key para lectura pública
WIKIPEDIA_LANGUAGE=en
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php
WIKIPEDIA_REST_URL=https://en.wikipedia.org/w/rest.php/v1

# Wikidata — API pública y SPARQL público
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql

# Wikimedia Commons — API pública
WIKIMEDIA_COMMONS_API_URL=https://commons.wikimedia.org/w/api.php

# Wikimedia Enterprise — opcional; token JWT, no API key estática
WIKIMEDIA_ENTERPRISE_AUTH_URL=https://auth.enterprise.wikimedia.com
WIKIMEDIA_ENTERPRISE_API_URL=https://api.enterprise.wikimedia.com
WIKIMEDIA_ENTERPRISE_USERNAME=
WIKIMEDIA_ENTERPRISE_PASSWORD=
WIKIMEDIA_ENTERPRISE_ACCESS_TOKEN=
WIKIMEDIA_ENTERPRISE_REFRESH_TOKEN=
WIKIMEDIA_ENTERPRISE_PROJECT=enwiki

# Openverse — token opcional para mayores límites
OPENVERSE_API_URL=https://api.openverse.org/v1
OPENVERSE_API_TOKEN=

# Library of Congress — no requiere key para el JSON API público
LIBRARY_OF_CONGRESS_API_URL=https://www.loc.gov

# Europeana — requiere wskey/API key
EUROPEANA_API_URL=https://api.europeana.eu/record/v2
EUROPEANA_API_KEY=

# NASA APIs — DEMO_KEY sirve para probar; una key propia aumenta los límites
NASA_API_URL=https://api.nasa.gov
NASA_API_KEY=DEMO_KEY
NASA_IMAGES_API_URL=https://images-api.nasa.gov

# World Bank Indicators API — no requiere key
WORLD_BANK_API_URL=https://api.worldbank.org/v2

# OpenStreetMap API — lectura pública; usa un User-Agent identificable
OPENSTREETMAP_API_URL=https://api.openstreetmap.org/api/0.6

# Overpass — lectura pública; preferir consultas con bbox para no sobrecargar
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_API_URL=https://overpass.kumi.systems/api/interpreter
OVERPASS_DEFAULT_BBOX=

# DPLA — requiere solicitar una key por correo
DPLA_API_URL=https://api.dp.la/v2
DPLA_API_KEY=
