# ─────────────────────────────────────────────────────────────────────────────
# NEXA BRIEF — Archivo de configuración de entorno
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el .env al control de versiones (está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────


# ─── INTELIGENCIA ARTIFICIAL ─────────────────────────────────────────────────
# Google AI Studio (gratuito con límites): https://aistudio.google.com/
GEMINI_API_KEY=

# Novita AI o DeepSeek directo: https://novita.ai / https://platform.deepseek.com/
DEEPSEEK_API_KEY=


# ─── IMÁGENES ─────────────────────────────────────────────────────────────────
# Unsplash Developer: https://unsplash.com/developers
UNSPLASH_API_KEY=

# Pexels Developer: https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay API: https://pixabay.com/api/docs/
PIXABAY_API_KEY=


# ─── MÚSICA ───────────────────────────────────────────────────────────────────
# Jamendo Developer: https://developer.jamendo.com/
JAMENDO_API_KEY=


# ─── CONFIGURACIÓN DEL PIPELINE ───────────────────────────────────────────────
# Duración de video en segundos (defaults: 60–300)
# VIDEO_MIN_DURATION_SECONDS=60
# VIDEO_MAX_DURATION_SECONDS=300

# Trabajos paralelos máximos
# MAX_PARALLEL_JOBS=2

# Nivel de log: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# Orden de adaptadores de música: pixabay, jamendo, ytdlp
# MUSIC_ADAPTER_ORDER=["pixabay","jamendo","ytdlp"]


# ─────────────────────────────────────────────────────────────────────────────
# PUBLISHER — Publicación automática en redes sociales
# ─────────────────────────────────────────────────────────────────────────────

# ── Feature Flag ──────────────────────────────────────────────────────────────
# Cambia a true para activar el Stage 9 del pipeline (publicación automática).
# Con false (default) el pipeline termina en PACKAGED sin ningún cambio de comportamiento.
ENABLE_AUTO_PUBLISHING=false

# ── Cuenta activa ─────────────────────────────────────────────────────────────
# Cambia ESTA SOLA variable para apuntar a cualquiera de las 6 cuentas.
# Formato: plataforma:alias (plataforma = tiktok | youtube | facebook)
# Ejemplos: tiktok:cuenta_1 | youtube:canal_2 | facebook:pagina_1
ACTIVE_ACCOUNT=tiktok:cuenta_1

# ── Seguridad — Clave de cifrado de tokens ────────────────────────────────────
# Clave Fernet AES-256 para cifrar los tokens en accounts.json.
# Genera una nueva con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANTE: Si pierdes esta clave, los tokens cifrados son irrecuperables.
PUBLISHER_ENCRYPTION_KEY=

# Ruta al archivo de cuentas y tokens cifrados (default: ./accounts.json)
# ACCOUNTS_JSON_PATH=accounts.json


# ── TikTok — OAuth 2.0 ────────────────────────────────────────────────────────
# Registro: https://developers.tiktok.com/
# Scopes requeridos: tiktok.post.publish
# Access token expira en: 24 horas | Refresh token expira en: 365 días
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Nombres descriptivos de las cuentas TikTok (solo etiquetas, no afectan la lógica)
TIKTOK_ACCOUNT_1_NAME=cuenta_tiktok_principal
TIKTOK_ACCOUNT_2_NAME=cuenta_tiktok_secundaria


# ── YouTube — OAuth 2.0 ───────────────────────────────────────────────────────
# Registro: https://console.cloud.google.com/ → YouTube Data API v3
# Scopes requeridos: https://www.googleapis.com/auth/youtube.upload
# Access token expira en: 1 hora | Refresh token: no expira (salvo revocación)
# ALERTA DE CUOTA: videos.insert cuesta 1,600 unidades de las 10,000 diarias.
#                  Máximo 6 subidas por día con la cuota estándar.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

YOUTUBE_ACCOUNT_1_NAME=canal_youtube_principal
YOUTUBE_ACCOUNT_2_NAME=canal_youtube_secundario

# Límites de cuota de YouTube (puedes ajustar si tienes extensión de cuota)
# YOUTUBE_DAILY_QUOTA_LIMIT=10000
# YOUTUBE_QUOTA_COST_PER_UPLOAD=1600


# ── Facebook — OAuth 2.0 ──────────────────────────────────────────────────────
# Registro: https://developers.facebook.com/
# Scopes requeridos: pages_manage_posts, pages_read_engagement, pages_show_list
# Page Access Tokens derivados de Long-Lived User Token NO EXPIRAN.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

FACEBOOK_ACCOUNT_1_NAME=pagina_facebook_principal
FACEBOOK_ACCOUNT_2_NAME=pagina_facebook_secundaria


# ── Timeouts de subida ────────────────────────────────────────────────────────
# Segundos antes de que expire una petición de subida de video (default: 300)
# PUBLISHER_UPLOAD_TIMEOUT_SECONDS=300

# El token se refresca cuando le quedan menos de X segundos (default: 1800 = 30 min)
# PUBLISHER_TOKEN_REFRESH_MARGIN_SECONDS=1800
