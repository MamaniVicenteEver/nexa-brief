# Servidor HTTP
PORT=4000
HOST=0.0.0.0

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379
# En contenedores: espera máxima de 5 s y hasta 3 reconexiones.
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_CONNECT_RETRIES=3

# Directorio de trabajo — cada job usa un subdirectorio efímero acá,
# borrado al terminar salvo NEXA_RENDER_KEEP_WORKDIRS=true (debug)
WORK_DIR=./work
# OUT_DIR/<motor>/<jobId> contiene metadata.json, resources/ y outputs/.
OUT_DIR=./out
KEEP_WORKDIRS=false

# Nivel de logs estructurados: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# CORS — orígenes permitidos para la GUI (web/)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Concurrencia por motor (cuántos jobs de ESE motor corren en simultáneo)
PLAYWRIGHT_CONCURRENCY=2
REMOTION_CONCURRENCY=3
HYPERFRAMES_CONCURRENCY=3

# Límites de sandboxing
JOB_TIMEOUT_MS=180000
# Dominios externos permitidos durante la captura de Playwright (además del
# servidor estático efímero del propio job). Separados por coma.
NETWORK_ALLOWLIST=fonts.googleapis.com,fonts.gstatic.com,cdn.jsdelivr.net,cdnjs.cloudflare.com,images.unsplash.com,interactive-examples.mdn.mozilla.net

# Recursos externos: se descargan por job, se validan contra NETWORK_ALLOWLIST
# y se sirven localmente durante el render. Ajustá según el tamaño máximo que
# quieras permitir por recurso (el valor por defecto es 250 MiB).
REMOTE_ASSET_TIMEOUT_MS=30000
REMOTE_ASSET_MAX_BYTES=262144000
REMOTE_ASSET_MAX_REDIRECTS=3

# Duración a usar cuando el job no trae audio
DEFAULT_STATIC_DURATION_SECONDS=5

# Binario local de HyperFrames (se resuelve solo si se deja vacío)
HYPERFRAMES_BIN=

# AWS (solo Remotion y HyperFrames; Playwright queda deliberadamente local).
# En desarrollo exportá las credenciales estándar de AWS en la sesión. En
# producción, usá un IAM role de la plataforma de cómputo, no claves estáticas.
AWS_REGION=us-east-1
AWS_RENDER_TIMEOUT_MS=900000
REMOTION_AWS_FUNCTION_NAME=
REMOTION_AWS_SITE_PREFIX=nexa-render
REMOTION_AWS_FRAMES_PER_LAMBDA=120
HYPERFRAMES_AWS_STACK_NAME=
HYPERFRAMES_AWS_BUCKET=
HYPERFRAMES_AWS_STATE_MACHINE_ARN=
HYPERFRAMES_AWS_CHUNK_SIZE=240
HYPERFRAMES_AWS_MAX_PARALLEL_CHUNKS=2
